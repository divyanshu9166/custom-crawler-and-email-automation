# Run python scripts/init_env.py to generate local secrets. Never commit .env.
ADMIN_USER=admin
ADMIN_PASSWORD=
API_TOKEN=
PUBLIC_URL=http://localhost:8000
DATA_DIR=data
# Initial defaults; saved Settings > Worker & sending controls override both flags.
WORKER_ENABLED=true

# Sending remains disabled until real credentials, sender identity and inbox checks are ready.
SENDING_ENABLED=false
# One initial email per recipient. Keep automatic follow-ups disabled.
FOLLOWUPS_ENABLED=false
SENDER_NAME=
SENDER_COMPANY=
SENDER_EMAIL=
SENDER_WEBSITE=
POSTAL_ADDRESS=
DOMAIN_AUTH_CONFIRMED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
DAILY_SEND_LIMIT=20
MIN_SEND_INTERVAL_SECONDS=180
SEND_HOUR_START=9
SEND_HOUR_END=17

# Host URL for local Python. Compose overrides service URLs to internal Docker DNS.
REACHER_URL=http://localhost:8080
REACHER_SECRET=
REACHER_PATH=/v0/check_email
REACHER_FROM_EMAIL=
REACHER_HELLO_NAME=
VERIFICATION_MAX_AGE_HOURS=72
VERIFICATION_INTERVAL_SECONDS=10

SEARCH_PROVIDER=searxng
SEARCH_LANGUAGE=en-GB
# Bounded alternate engines when default search is empty, irrelevant or partly unavailable.
SEARCH_FALLBACK_ENGINES=yahoo,mojeek
SEARCH_CACHE_SECONDS=900
SEARCH_FAILURE_COOLDOWN_SECONDS=60
# Independent URL index only; current official pages must be fetched before using any contact.
COMMONCRAWL_HINTS_ENABLED=true
PROFESSIONAL_REFRESH_OFFICIAL_LINKS=true
DISCOVERY_PLATFORMS=linkedin.com,x.com,peopleperhour.com,clutch.co,crunchbase.com,facebook.com,instagram.com,google.com
DISCOVERY_QUERY_DELAY_SECONDS=2
DISCOVERY_MAX_SIGNALS=40
# Contact/team index research corroborates contacts on captured official pages.
AUTO_CONTACT_RESEARCH=true
AUTO_PROFESSIONAL_RESEARCH=true
PROFESSIONAL_MAX_PROFILES=6
PROFESSIONAL_MAX_QUERIES=10
CONTACT_RESEARCH_MAX_PAGES=6
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=
SERPAPI_KEY=
# Optional third-party X public-bio hints via free FxEmbed. Disabled by default.
# Native denial stays visible; mirror hints cannot qualify/import/send contacts.
FXEMBED_PROFILES_ENABLED=false
# PageSpeed lab audit; automatic after research only when a key is configured.
# Without a key, manual audit remains available; Google quota/availability applies.
AUTO_PERFORMANCE_AUDIT=true
PAGESPEED_API_KEY=
CRAWL_MAX_PAGES=30
CRAWL_MAX_DEPTH=3
CRAWL_MAX_SITEMAPS=6
CRAWL_RENDER_MODE=always
CRAWL_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=1800
CRAWL_DELAY_SECONDS=2
# Total network/body deadline; declared robots pacing is separate.
CRAWL_REQUEST_TIMEOUT_SECONDS=30
# Only transient GET failures retry; long Retry-After goes to the job lane.
CRAWL_HTTP_RETRIES=1
CRAWL_RESUME_MAX_RETRIES=2
CRAWL_AUTO_CONTINUE=true
CRAWL_AUTO_MAX_PASSES=6
CRAWL_AUTO_MAX_PAGES=180
CRAWL_ADAPTIVE_PACING=true
CRAWL_ADAPTIVE_MAX_DELAY_SECONDS=10
CRAWL_ADAPTIVE_CONCURRENCY=true
# Optional process-tree memory budget; 0 uses host/common container headroom.
CRAWL_MEMORY_BUDGET_MB=0
CRAWL_TASK_MEMORY_MB=512
CRAWL_RETRY_MAX_WAIT_SECONDS=10
CRAWLER_USER_AGENT=OutreachResearchBot/0.1
BROWSER_ENABLED=true
PLATFORM_BROWSER_ENABLED=false
PLATFORM_BROWSER_PUBLIC_FALLBACK=true
PLATFORM_BROWSER_HEADLESS=true
PLATFORM_BROWSER_TIMEOUT_SECONDS=45
PLATFORM_BROWSER_DELAY_SECONDS=5
PLATFORM_BROWSER_SEARCH_STEPS=6
PLATFORM_BROWSER_SEARCH_PAGES=3
PLATFORM_BROWSER_SEARCH_TIMEOUT_SECONDS=60
# Only needed for the temporary loopback-only browser setup service.
PLATFORM_BROWSER_VIEW_PASSWORD=
PLATFORM_BROWSER_SETUP_SITE=linkedin
BROWSER_RESOURCE_CONCURRENCY=6
AUTO_VISUAL_AUDIT=true
INSTALL_BROWSER=true
APP_MEMORY_LIMIT=2560m
APP_CPU_LIMIT=1.5

# Optional research suggestions only; these settings do not write emails.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required for individually composed research-based email drafts. No template fallback.
# Use an endpoint whose terms permit your intended use; free NVIDIA trials are for evaluation.
DRAFT_API_URL=https://integrate.api.nvidia.com/v1
DRAFT_API_KEY=
DRAFT_MODEL=
DRAFT_TIMEOUT_SECONDS=90

# Optional n8n scheduler profile. The app alone owns outbound scheduling.
N8N_ENCRYPTION_KEY=
